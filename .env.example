# CareerHub configuration — copy to `.env` and fill in values.
# This file contains placeholders only. Never commit a real `.env`.

# ─── Local development (npm run dev) ─────────────────────────────────────────
# Matches docker-compose.dev.yml (Postgres published on 127.0.0.1:5434).
DATABASE_URL="postgresql://careerhub:careerhub_dev_password@127.0.0.1:5434/careerhub?schema=public"
# Integration tests create/drop this database (name must end in _test).
TEST_DATABASE_URL="postgresql://careerhub:careerhub_dev_password@127.0.0.1:5434/careerhub_test?schema=public"
APP_URL="http://localhost:3005"

# ─── Docker Compose (docker compose up --build -d) ──────────────────────────
POSTGRES_USER=careerhub
# REQUIRED. Use URL-safe characters only, e.g. the output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me-to-a-long-random-hex-string
POSTGRES_DB=careerhub
# Host port for the app (bound to 127.0.0.1 unless APP_BIND=0.0.0.0).
APP_PORT=8088
APP_BIND=127.0.0.1
# Public URL users reach the app at (used for configuration checks).
PUBLIC_URL=http://localhost:8088
# Optional Nginx reverse proxy (docker compose --profile proxy up -d).
PROXY_PORT=8089
PROXY_BIND=127.0.0.1
# Set to true only when a reverse proxy you control sets X-Forwarded-For.
TRUST_PROXY=false

# ─── Security ────────────────────────────────────────────────────────────────
# Session cookies are Secure by default in production. Browsers accept Secure
# cookies on http://localhost; set false ONLY for plain-HTTP access from other
# hosts during local testing (never with https / in production).
# COOKIE_SECURE=true
SESSION_TTL_DAYS=7

# ─── Resume storage ──────────────────────────────────────────────────────────
# local = filesystem / Docker volume; s3 = any S3-compatible object storage.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
# Max resume size in bytes (≤ 5 MB).
RESUME_MAX_BYTES=5242880
# Required when STORAGE_DRIVER=s3:
S3_BUCKET=
S3_REGION=
# Optional custom endpoint (MinIO, R2, B2…); leave empty for AWS.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO-style path addressing.
S3_FORCE_PATH_STYLE=false

# ─── Demo seed (development / evaluation only) ───────────────────────────────
# Defaults are documented in README.md. Override to use your own dev passwords.
# SEED_ADMIN_PASSWORD=
# SEED_RECRUITER_PASSWORD=
# SEED_CANDIDATE_PASSWORD=
