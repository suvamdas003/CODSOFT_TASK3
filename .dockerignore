# Keep the build context small and free of secrets.

# Environment files (secrets) — never sent to the Docker daemon
.env
.env.*
!.env.example

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
build
src/generated
*.tsbuildinfo
next-env.d.ts

# Uploaded resumes and local runtime data (personal data must never enter images)
storage
uploads
backups
*.dump
*.sql.gz

# Tests artefacts, caches, logs
coverage
test-results
playwright-report
blob-report
*.log

# Local tooling, VCS, archives, docs
.git
.gitignore
.vscode
.idea
.claude
release
*.zip
docs
README.md
Dockerfile
.dockerignore
docker-compose*.yml

# Tests are not part of the production image
tests
playwright.config.ts
vitest.config.mts
